+// Parsed stylesheets keyed by their source text, most recent first. Parsing
+// CSS dominates createFromString on slow targets that rebuild the same page
+// every second; selectors are not modified after sort_selectors().
+static std::vector<std::pair<string, css>> css_cache;
+static const size_t css_cache_max = 8;
+
+static bool css_cache_get(const string& key, css& out)
+{
+	for (size_t i = 0; i < css_cache.size(); i++)
+	{
+		if (css_cache[i].first != key) continue;
+		out = css_cache[i].second;
+		if (i) std::rotate(css_cache.begin(), css_cache.begin() + i, css_cache.begin() + i + 1);
+		return true;
+	}
+	return false;
+}
+
+static void css_cache_put(const string& key, const css& styles)
+{
+	css_cache.insert(css_cache.begin(), {key, styles});
+	if (css_cache.size() > css_cache_max) css_cache.pop_back();
+}
